     $pending=Get-Content -LiteralPath $transaction -Raw -Encoding UTF8 | ConvertFrom-Json
-    if($pending.manual_rollback_pending -ne $true){
+    # A previously committed update may retain its journal if Windows held
+    # a handle to the old backup. Match both the last-good receipt and active
+    # version before allowing a normal start; no automatic file deletion.
+    $committed=$false
+    if([string]$pending.phase -eq 'committed'){
+        $lastGoodPath=Join-Path $Root 'updater\last-good.json'
+        if(Test-Path -LiteralPath $lastGoodPath){
+            try{
+                $last=Get-Content -LiteralPath $lastGoodPath -Raw -Encoding UTF8 | ConvertFrom-Json
+                $committed=([int]$last.schema -eq 1 -and [string]$last.version -eq [string]$pending.from -and
+                    [string]$last.updated_to -eq [string]$pending.to -and
+                    [string]$version.version -eq [string]$pending.to)
+            }catch{$committed=$false}
+        }
+    }
+    if($pending.manual_rollback_pending -ne $true -and -not $committed){
        throw 'Unterbrochene Update-Transaktion: bitte vor Start Wiederherstellung pruefen.'
     }
 }
